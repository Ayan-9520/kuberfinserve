# --- Customer + admin emails (required for Gmail inbox delivery) ---
# Gmail: 2-Step ON → App password → use below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your@gmail.com
LEADS_TO=loanleads@kuberfinserve.com

# Use local SMTP API when PHP mail fails (dev: npm run dev starts this)
VITE_USE_SMTP_API=true

# Lead API — leave enabled; dev proxies save-lead.php to server/lead-api.mjs
# VITE_USE_LEAD_API=false

# Optional: Web3Forms = admin inbox only; customer mail still needs SMTP above
# VITE_WEB3FORMS_ACCESS_KEY=your_key

# Lead API (Hostinger MySQL) — production:
# VITE_LEAD_API_URL=https://kuberfinserve.com

# Partner JWT (dev server uses JWT_SECRET; production: api/config.php jwt_secret)
# JWT_SECRET=dev-partner-jwt-secret-change-in-production

# Customer mobile app API key (POST /api/mobile/save-lead.php)
# MOBILE_API_KEY=dev-mobile-api-key

# --- KuberOne dual-write (Admin CRM) ---
# Local Docker API: http://127.0.0.1:4000
KUBERONE_BRIDGE_ENABLED=false
KUBERONE_API_BASE=http://127.0.0.1:4000
# Must match WEBSITE_INTAKE_API_KEY on KuberOne when that key is set
# KUBERONE_API_KEY=

# Hostinger api/config.php — add same SMTP settings for live site emails
